<?xml version="1.0" encoding="utf-8"?>
<!-- 영수증 원본과 초대 정보는 기기 밖으로 백업하거나 옮기지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
